{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "书桌防线",
  "mainBinaryName": "desk-defense",
  "version": "0.1.0",
  "identifier": "games.jjjj.deskdefense",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "书桌防线 Desk Defense",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#E8D5B5"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "StrategyGame",
    "shortDescription": "书桌题材的迷宫式塔防游戏",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
