{
  "name": "desk-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "vite-node scripts/simulate.ts",
    "docs:data": "vite-node scripts/gen-data-docs.ts",
    "gallery": "node scripts/build-gallery.mjs",
    "deploy": "npm run build && npx wrangler@4 pages deploy dist --project-name desk-defense",
    "test:online": "vitest run tests/online",
    "typecheck:functions": "tsc --noEmit -p functions",
    "db:migrate:local": "npx wrangler@4 d1 migrations apply desk-defense --local",
    "db:migrate:remote": "npx wrangler@4 d1 migrations apply desk-defense --remote",
    "dev:api": "vite build && npx wrangler@4 pages dev dist",
    "agent:play": "vite-node scripts/agent-play.ts",
    "mcp": "vite-node scripts/mcp-server.ts",
    "agent:bridge": "vite-node scripts/agent-bridge.ts",
    "agent:tokens": "vite-node scripts/agent-tokens.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "phaser": "^3.90.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
