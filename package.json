{
  "name": "desk-defense",
  "private": true,
  "version": "0.3.7",
  "description": "在书桌上用文具摆迷宫的塔防游戏，也可以让大模型来玩",
  "license": "MIT",
  "homepage": "https://jjjj.games",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Owlbay/desk-defense.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "vite-node scripts/simulate.ts",
    "docs:data": "vite-node scripts/gen-data-docs.ts",
    "gallery": "node scripts/build-gallery.mjs",
    "deploy": "npm run build && npx wrangler@4 pages deploy dist --project-name desk-defense",
    "release": "node scripts/release.mjs",
    "test:online": "vitest run tests/online",
    "typecheck:functions": "tsc --noEmit -p functions",
    "db:migrate:local": "npx wrangler@4 d1 migrations apply desk-defense --local",
    "db:migrate:remote": "npx wrangler@4 d1 migrations apply desk-defense --remote",
    "dev:api": "vite build && npx wrangler@4 pages dev dist",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "agent:play": "vite-node scripts/agent-play.ts",
    "mcp": "vite-node scripts/mcp-server.ts",
    "agent:bridge": "vite-node scripts/agent-bridge.ts",
    "agent:tokens": "vite-node scripts/agent-tokens.ts",
    "agent:eval": "vite-node scripts/agent-eval.ts",
    "agent:batch": "vite-node scripts/agent-batch.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "check": "npm run typecheck && npm run typecheck:functions && npm run lint && npm run format:check && npm run test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "phaser": "^3.90.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.12.6",
    "@types/ws": "^8.18.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "basic-ftp": "^6.2.6",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  }
}
